BOT_TOKEN=
DATABASE_URL=sqlite:///bot.db
BOT_TIMEZONE=Europe/Moscow
REPORT_DEFAULT_DAYS=14
TELEGRAM_PROXY_URL=

WEB_HOST=127.0.0.1
WEB_PORT=8080
WEB_BASE_URL=http://127.0.0.1:8080/miniapp
MINIAPP_ALLOWED_USERNAMES=
MINIAPP_AUTH_MAX_AGE_SECONDS=86400

# Enable the Codex queue only for explicit numeric Telegram user IDs.
CODEX_ALLOWED_USER_IDS=
# A separate random secret shared with the Mac worker; never commit its value.
CODEX_WORKER_TOKEN=

# Read-only MinIO identity for factory/events and factory/agent-runs/v1.
OFFICE_MINIO_ENDPOINT=
OFFICE_MINIO_BUCKET=
OFFICE_MINIO_ACCESS_KEY=
OFFICE_MINIO_SECRET_KEY=
OFFICE_MINIO_REGION=us-east-1

DOQA_PARSER_OUTPUT_DIR=task_tracker_data/doqa_runs
DOQA_PARSER_MAX_INPUT_MB=40
DOQA_PARSER_MAX_PAGES=250
DOQA_PARSER_CONCURRENCY=1
DOQA_PARSER_ALLOWED_USERNAMES=

DOQA_BASE_URL=
DOQA_API_TOKEN=
DOQA_REPORT_URL_TEMPLATE=
DOQA_SPACE_ID=
# Spaces searched only by the manual Mini App tool (Fast-track, Flutter, Native).
DOQA_SPACE_IDS=2,4,6
DOQA_API_TIMEOUT_SECONDS=60
DOQA_REPORT_RETRY_DELAYS_SECONDS=15,60,180
DOQA_PDF_FONT_PATH=

# Generated DoQA ZIP reports are written to QADB when both values are set.
QADB_URL=
QADB_SERVICE_KEY=
QADB_REPORT_TZ=+03:00
QADB_TIMEOUT_SECONDS=60
